{
  "name": "@launchproof/browser",
  "version": "0.1.0",
  "description": "LaunchProof browser verification: Playwright workflows, axe-core accessibility, and navigation performance metrics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@launchproof/core": "0.1.0"
  },
  "peerDependencies": {
    "axe-core": ">=4.9.0",
    "playwright": ">=1.45.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
