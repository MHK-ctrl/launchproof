# LaunchProof environment template.
#
# Copy to .env and fill in only the values you need. Never commit .env.
# LaunchProof only reads the variables referenced by your config file.
# All live-testing variables are optional; the default scan is local and offline.

# Local application under test
LAUNCHPROOF_APP_URL=http://localhost:3000

# Test identities (header values are injected into API/authorization tests).
# Referenced from launchproof.config.json -> auth.identities.<name>.headersEnv
LAUNCHPROOF_USER_A_TOKEN=
LAUNCHPROOF_USER_B_TOKEN=
LAUNCHPROOF_ADMIN_TOKEN=

# Optional Supabase live RLS check. Use a STAGING project and a read-only anon key.
# Never put a service-role key here.
SUPABASE_ANON_KEY=

# Optional AI remediation. Disabled unless ai.enabled and ai.consent are true
# in launchproof.config.json, and this key is present.
LAUNCHPROOF_AI_API_KEY=
