# LaunchProof environment template.
#
# Copy to .env and fill in only the values you need. Never commit .env.
# This file covers both local scan configuration and the optional cloud dashboard.
# Local scans remain available without any cloud variables.

# ---- Local/live scan target (optional) ----
LAUNCHPROOF_APP_URL=http://localhost:3000

# Test identities for local authorization checks.
LAUNCHPROOF_USER_A_TOKEN=
LAUNCHPROOF_USER_B_TOKEN=
LAUNCHPROOF_ADMIN_TOKEN=

# Optional Supabase live RLS check for target applications (staging, read-only anon key).
SUPABASE_ANON_KEY=

# Optional AI remediation.
LAUNCHPROOF_AI_API_KEY=

# ---- Cloud dashboard (optional, required for hosted web app) ----
# Supabase project values from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to browsers, CLI output, or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL used by auth callbacks and CLI device flow.
# Local development: http://127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000

# Base64-encoded 32-byte key for short-lived encrypted cookies (GitHub connect token).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LAUNCHPROOF_ENCRYPTION_KEY=

# ---- CLI upload target (optional) ----
# Defaults to http://127.0.0.1:3000 when unset.
LAUNCHPROOF_API_URL=
